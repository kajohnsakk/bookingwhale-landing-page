---
import ContentLayout from '../layouts/ContentLayout.astro';
import BusinessMotion from './BusinessMotion.astro';
import RestaurantBusiness from './RestaurantBusiness.astro';
import ServiceBusiness from './ServiceBusiness.astro';
import { businessPages } from '../data/business-pages';
interface Props { slug: string; locale?: 'th' | 'en' | 'zh' }
const {slug,locale='th'} = Astro.props;
const page = businessPages.find(item => item.slug === slug)!;
const copy = page[locale === 'zh' ? 'th' : locale];
const isThai = locale !== 'en';
const prefix = locale === 'th' ? '' : `/${locale}`;
const breadcrumb = [{name:isThai ? 'สำหรับธุรกิจ' : 'For businesses',path:`${prefix}/businesses/`},{name:copy.title,path:`${prefix}/businesses/${slug}/`}];
---
<ContentLayout title={`${copy.title} | Booking Whale`} description={copy.description} {locale} {breadcrumb}>
  {slug === 'food-beverage' ? <RestaurantBusiness {locale} /> : <ServiceBusiness slug={slug as 'fitness-sports' | 'services'} {locale} />}
  <aside class="editorial-cta"><h2>{isThai ? 'ดูรูปแบบสำหรับธุรกิจอื่น' : 'Explore other business types'}</h2><ul>{businessPages.filter(item => item.slug !== slug).map(item => <li><a href={`${prefix}/businesses/${item.slug}/`}>{item[locale === 'zh' ? 'th' : locale].title}</a></li>)}</ul></aside>
  <BusinessMotion />
</ContentLayout>
