---
import Icon from "./Icon.astro";
const steps = [
  { label: 'เชื่อมต่อ', title: 'เชื่อม LINE OA ของร้าน', description: 'ใช้ LINE OA เดิมพาลูกค้าเข้าหน้าจอง' },
  { label: 'ตั้งค่ารอบจอง', title: 'กำหนดรอบรับจอง', description: 'เลือกบริการ เวลา และจำนวนคนที่รับได้ในแต่ละรอบ' },
  { label: 'เปิดรับจอง', title: 'แชร์หน้าจองให้ลูกค้า', description: 'ส่งลิงก์ผ่าน LINE OA แล้วให้ลูกค้าเลือกจองเอง' },
];
---
<section class="bw-container bw-section bw-how" id="how">
  <div class="bw-journey-head"><div class="bw-heading"><span class="bw-eyebrow">คุณกำหนดรอบ ลูกค้าเลือกจอง</span><h2>เริ่มรับจอง <em>ใน 3 ขั้นตอน</em></h2></div><a class="bw-inline-link" href="#contact">คุยกับทีมงาน <Icon name="arrow-up-right" class="bw-action-icon" /></a></div>
  <div class="bwx-steps" role="list">
    {steps.map((step, index) => <article class="bwx-step" role="listitem">
      <div class="bwx-step-visual" aria-hidden="true">
        {index === 0 && <div class="bwx-sv bwx-sv-connect"><img src="/assets/line-mark-72.png" loading="lazy" width="32" height="32" alt="" /><span><strong>Booking Whale</strong><small>เชื่อมระบบจอง</small></span><span class="bwx-switch"><i></i></span></div>}
        {index === 1 && <div class="bwx-sv bwx-sv-setting"><Icon name="clock" /><span><strong>19:00–20:00</strong><small>จองโต๊ะมื้อเย็น</small></span><b>รับได้ 8 คน</b></div>}
        {index === 2 && <div class="bwx-sv bwx-sv-link"><Icon name="link" /><span>Whale Guide · จองโต๊ะ</span><span class="bwx-sv-copy">คัดลอก</span></div>}
      </div>
      <p class="bwx-step-label"><span>0{index + 1}</span>{step.label}</p>
      <h3>{step.title}</h3>
      <p class="bwx-step-desc">{step.description}</p>
    </article>)}
  </div>
</section>
