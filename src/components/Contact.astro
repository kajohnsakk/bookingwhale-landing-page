---
import Icon from "./Icon.astro";
import { localeFromPath } from "../i18n";
const locale=localeFromPath(Astro.url.pathname);
const captures=`/assets/product-captures/${locale}/`;
---
<section id="contact" class="bw-container bw-contact bw-contact-showcase bw-contact-banner">
  <div class="bw-contact-copy"><span class="bw-eyebrow">BOOKING WHALE</span><h2>ให้ลูกค้าจองง่าย<br><em>ให้ร้านจัดการคล่อง</em></h2><p><span class="bw-copy-sentence">เล่าให้เราฟังว่าร้านคุณรับจองแบบไหน</span> <span class="bw-copy-sentence">ทีมงานจะพาดูระบบและช่วยหาวิธีเริ่มต้นที่เหมาะกับคุณ</span></p><div class="bw-contact-actions"><a class="bw-button bw-primary bw-start-button" data-contact-open href="https://bookingwhale.co/contact" aria-haspopup="dialog" aria-controls="contact-dialog"><span>เริ่มใช้งาน</span><span class="bw-start-arrow" aria-hidden="true"><Icon name="arrow-right" /></span></a></div></div>
  <div class="bw-contact-products bw-cta-devices" role="img" aria-label="ตัวอย่างหน้าจองของลูกค้าและระบบจัดการรายการจองของร้าน">
    <figure class="bw-cta-desktop"><div class="bw-cta-desktop-screen"><div class="bw-cta-browser"><i></i><i></i><i></i><span>Booking Whale · ระบบจัดการร้าน</span></div><img src={`${captures}merchant-bookings.webp`} width="1000" height="654" loading="lazy" decoding="async" alt="" /></div><div class="bw-cta-desktop-stand"></div><div class="bw-cta-desktop-base"></div></figure>
    <figure class="bw-cta-handset"><div class="bw-cta-handset-status"><b>9:41</b><i></i><span>•••</span></div><div class="bw-cta-handset-screen"><img src={`${captures}customer-booking.webp`} width="780" height="1802" loading="lazy" decoding="async" alt="" /></div><span class="bw-cta-home"></span></figure>
  </div>
</section>
