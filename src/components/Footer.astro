---
import Icon from "./Icon.astro";
import '../styles/footer-controls.css';
interface Props { sectionBase?: string }
const { sectionBase = '' } = Astro.props;
---
<footer class="bw-container bw-footer bw-footer-refined">
  <div class="bw-footer-top">
    <div class="bw-footer-identity">
      <a class="bw-brand" href={sectionBase || '#top'} aria-label="Booking Whale หน้าแรก"><img src="/assets/bookingwhale-wordmark-480.png" width="480" height="90" alt="Booking Whale" loading="lazy" decoding="async" /></a>
      <p>จองง่ายสำหรับลูกค้า<br>จัดการคล่องสำหรับร้าน</p>
      <span class="bw-footer-caption">ระบบจองคิวผ่าน LINE OA</span>
    </div>
    <div class="bw-footer-navigation">
      <strong>รู้จัก Booking Whale</strong>
      <a href={`${sectionBase}#features`}>จองยังไง</a>
      <a href={`${sectionBase}#business`}>สำหรับธุรกิจของคุณ</a>
      <a data-contact-open href="https://bookingwhale.co/contact" aria-haspopup="dialog" aria-controls="contact-dialog">เริ่มใช้งาน</a>
      <a href={`${sectionBase}#faq`}>คำถามที่พบบ่อย</a>
      <a href="/blog/">บทความสำหรับธุรกิจ</a>

    </div>
    <div class="bw-footer-contact">
      <strong>ติดต่อเรา</strong>
      <a class="bw-footer-email" href="mailto:info@bookingwhale.co">info@bookingwhale.co <Icon name="arrow-up-right" class="bw-action-icon" /></a>
      <a href="tel:0970166045"><Icon name="phone" />097-016-6045</a>
      <a href="tel:0805956458"><Icon name="phone" />080-595-6458</a>
    </div>
  </div>
  <div class="bw-footer-bottom">
    <span>© 2026 Booking Whale</span>
    <div class="bw-footer-legal">
    <a href="/privacy-policy/">นโยบายความเป็นส่วนตัว <Icon name="arrow-up-right" class="bw-action-icon" /></a>
    <a href="/terms/">ข้อกำหนดการใช้บริการ <Icon name="arrow-up-right" class="bw-action-icon" /></a>
    </div>
  </div>
</footer>
<button id="bw-back-to-top" class="bw-back-to-top" type="button" aria-label="กลับด้านบน" title="กลับด้านบน"><Icon name="arrow-up" /></button>
<script>
  import '../scripts/back-to-top.js';
</script>
