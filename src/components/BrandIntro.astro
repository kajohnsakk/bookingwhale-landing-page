---
import Icon from "./Icon.astro";
import { clients } from "../data/clients";
import { seasons } from "../data/seasons";
const named = clients.slice(0, 2);
const more = clients.length - named.length;
const logos = clients.filter(client => client.avatar).slice(0, 4);
---
<section class="bwx-intro" aria-label="Booking Whale">
  <div class="bwx-intro-inner">
    {seasons.map(season => <p class="bwx-intro-eyebrow bwx-season-greeting" data-season-greeting={season.id}><Icon name={season.icon} /><span>{season.greeting}</span></p>)}
    <p class="bwx-intro-title">Booking Whale</p>
    <a class="bwx-proof" href="#clients">
      {logos.length > 0 && (
        <span class="bwx-proof-logos" aria-hidden="true">
          {logos.map(client => <img src={client.avatar} alt="" width="28" height="28" decoding="async" />)}
        </span>
      )}
      <span class="bwx-proof-label">ร้านที่รับจองผ่านเรา</span>
      <span class="bwx-proof-break" aria-hidden="true"></span>
      <span class="bwx-proof-names">{named.map(client => <span>{client.name}</span>)}</span>
      {more > 0 && <span class="bwx-proof-more">+{more}</span>}
      <Icon name="chevron-right" class="bwx-proof-arrow" />
    </a>
  </div>
</section>
