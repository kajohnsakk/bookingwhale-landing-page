---
interface Props {
  person: "emma" | "daniel";
}
const { person } = Astro.props;
const portraits = {
  emma: "/assets/avatars/emma-wilson",
  daniel: "/assets/avatars/daniel-carter",
};
---
<img class="bw-customer-avatar" src={`${portraits[person]}-72.webp`} srcset={`${portraits[person]}-72.webp 72w, ${portraits[person]}-128.webp 128w`} sizes="40px" alt="" width="128" height="128" loading="lazy" decoding="async" />
<style>
  .bw-customer-avatar {
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
    border-radius: inherit;
    object-fit: cover;
  }
</style>
