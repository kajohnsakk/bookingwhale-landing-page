---
import { getCollection } from "astro:content";
import { t } from "../i18n/utils";
import type { Lang } from "../i18n/utils";
import { getSlug } from "../utils/slug";

interface Props {
  lang?: Lang;
}
const { lang = "th" } = Astro.props;

const allPosts = await getCollection("blog", ({ data }) => data.lang === lang);
const posts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);
---

<section
  id="blog"
  class="section-padding bg-white"
  aria-labelledby="blog-heading"
>
  <div class="mx-auto px-6 sm:px-10 md:px-14 lg:px-24 max-w-[1400px]">
    <div data-animate="scroll-reveal">
      <div class="text-center mb-16">
        <h2
          id="blog-heading"
          class="text-[1.75rem] sm:text-[2.25rem] lg:text-[2.75rem] font-black text-gray-900 tracking-[-0.03em]"
        >
          <span data-translate="blogTitle">{t("blogTitle", lang)}</span>
        </h2>
        <p
          data-translate="blogDescription"
          class="text-xl text-gray-600 max-w-xl mx-auto mt-4 font-medium"
        >
          {t("blogDescription", lang)}
        </p>
      </div>
    </div>

    <div
      data-animate="scroll-reveal"
      data-stagger-delay="0.12"
      class="grid md:grid-cols-2 xl:grid-cols-3 gap-5 sm:p-6 lg:gap-8 mb-10 lg:mb-12"
    >
      {
        posts.map((post) => {
          const formattedDate = post.data.pubDate.toLocaleDateString(
            lang === "th" ? "th-TH" : "en-US",
            {
              year: "numeric",
              month: "long",
              day: "numeric",
            },
          );

          return (
            <div data-animate-child="fade-up" class="h-full">
              <article class="group relative bg-white rounded-2xl border border-gray-100 shadow-sm shadow-gray-900/5 hover:shadow-xl hover:shadow-gray-900/10 hover:-translate-y-1 transition-all duration-300 overflow-hidden h-full flex flex-col">
                {post.data.heroImage && (
                  <a
                    href={`/blog/${getSlug(post.id)}`}
                    tabindex="-1"
                    aria-hidden="true"
                    class="relative block overflow-hidden"
                  >
                    <img
                      src={post.data.heroImage}
                      alt={post.data.title}
                      width="600"
                      height="315"
                      class="w-full aspect-[1200/630] object-cover group-hover:scale-[1.04] transition-transform duration-500 ease-out"
                      loading="lazy"
                    />
                    <span class="absolute top-4 left-4 bg-white/90 backdrop-blur-sm text-gray-900 text-xs font-bold px-3 py-1.5 rounded-full shadow-sm">
                      {post.data.category}
                    </span>
                  </a>
                )}
                <div class="p-6 flex flex-col flex-1">
                  <h3 class="text-lg sm:text-xl font-bold text-gray-900 leading-snug line-clamp-2 group-hover:text-blue-600 transition-colors">
                    <a
                      href={`/blog/${getSlug(post.id)}`}
                      class="focus:outline-none"
                    >
                      <span class="absolute inset-0" aria-hidden="true"></span>
                      {post.data.title}
                    </a>
                  </h3>
                  <p class="text-[15px] text-gray-600 mt-3 leading-relaxed line-clamp-3 flex-1">
                    {post.data.description}
                  </p>
                  <div class="mt-5 pt-4 border-t border-gray-100 flex items-center justify-between">
                    <span class="text-[13px] text-gray-400 font-medium">
                      {formattedDate}
                    </span>
                    <span class="text-blue-600 text-[13px] font-bold inline-flex items-center gap-1">
                      {lang === "th" ? "อ่านต่อ" : "Read more"}
                      <svg
                        class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M9 5l7 7-7 7"
                        />
                      </svg>
                    </span>
                  </div>
                </div>
              </article>
            </div>
          );
        })
      }
    </div>

    <div data-animate="fade-in" style="--delay: 0.15s">
      <div class="text-center mt-10 lg:mt-12">
        <a
          href="/blog"
          class="inline-flex items-center text-gray-700 hover:text-gray-900 font-bold py-3.5 px-8 rounded-full border-2 border-gray-200 hover:border-gray-400 transition-all duration-200"
        >
          <span data-translate="viewAllBlogs">{t("viewAllBlogs", lang)}</span>
          <svg
            class="w-4 h-4 ml-2"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
