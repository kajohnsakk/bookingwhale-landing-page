---
import Icon from "./Icon.astro";
import { localeFromPath } from '../i18n';
const businessPrefix = localeFromPath(Astro.url.pathname) === 'en' ? '/en' : '';
const businessLinks: Record<number,string> = {0:'food-beverage',1:'services',2:'fitness-sports',7:'services'};
const industries = [
  { kind:0, title:'ร้านอาหาร & เครื่องดื่ม', description:'ให้ลูกค้าเลือกมื้อ เวลา และจำนวนคนก่อนมาถึง', label:'ลูกค้าเลือกเวลาเอง', cap:'จองโต๊ะมื้อเย็น · 2 คน' },
  { kind:1, title:'ความงาม & เวลเนส', description:'เปิดเวลาจองนวด ดูแลผิว และทรีตเมนต์', label:'ลูกค้าเลือกระยะเวลาบริการ', cap:'นวดอโรม่า' },
  { kind:2, title:'ฟิตเนส & กีฬา', description:'เปิดคลาสให้จอง พร้อมกำหนดจำนวนที่รับ', label:'ลูกค้าเห็นที่ว่างในคลาส', cap:'พิลาทิส 18:00 · ว่างอีก 3 ที่' },
  { kind:3, title:'การศึกษา & การสอน', description:'ให้ผู้เรียนเลือกวันและเวลาเรียนที่สะดวก', label:'ลูกค้าเลือกวันและเวลาเรียน', cap:'English กับครูแดเนียล' },
  { kind:4, title:'อีเวนต์ & บัตรเข้างาน', description:'ให้ลูกค้าเลือกรอบกิจกรรมและจำนวนที่นั่ง', label:'ลูกค้าเลือกจำนวนที่นั่ง', cap:'เวิร์กช็อปออกแบบ' },
  { kind:5, title:'การท่องเที่ยว & ที่พัก', description:'จองรอบทัวร์ เลือกวันและจำนวนผู้ร่วมทริป', label:'ลูกค้าเลือกรอบทัวร์', cap:'เดินเที่ยวเมืองเก่า · 2 คน' },
  { kind:6, title:'ธุรกิจให้เช่า', description:'รับจองห้อง สตูดิโอ และอุปกรณ์ตามช่วงเวลา', label:'ลูกค้าจองช่วงเวลาที่ต้องการ', cap:'สตูดิโอ A · 24 ต.ค.' },
  { kind:7, title:'บริการทั่วไป', description:'เปิดเวลาปรึกษาและบริการให้ลูกค้าจองล่วงหน้า', label:'ลูกค้าเลือกวันนัดหมาย', cap:'จองเวลาปรึกษา · 60 นาที' },
] as const;
---
<div class="bw-business-scroll-track">
<section class="bw-container bw-section bw-business" id="business">
  <div class="bw-business-intro"><div class="bw-heading"><span class="bw-eyebrow">ประเภทธุรกิจ</span><h2>ธุรกิจแบบไหน<br><em>ก็รับจองได้</em></h2><p class="bw-business-context">ทั้งจองโต๊ะ จองคลาส และนัดหมายบริการ คุณกำหนดเวลาและจำนวนที่รับ ลูกค้าเลือกรอบที่สะดวก</p></div></div>
  <div id="business-gallery" class="bw-industry-viewport" tabindex="0" role="region" aria-label="รูปแบบการจองสำหรับธุรกิจ"><div class="bw-business-directory">
    {industries.map((item) => <article class="bw-industry-graphic">
      <div class="bwx-snap" data-industry-index={item.kind} aria-hidden="true">
        <div class="bwx-hl">
          <span class="bwx-hl-label">{item.label}</span>
          {item.kind===0&&<div class="bwx-chips"><span>18:00</span><span class="is-on">19:00</span><span>20:30</span></div>}
          {item.kind===1&&<div class="bwx-chips bwx-chips-wide"><span>30 นาที</span><span class="is-on">60 นาที</span><span>90 นาที</span></div>}
          {item.kind===2&&<><div class="bwx-seats">{Array.from({length:8},(_,i)=><i class:list={{'is-on':i<5}} />)}</div></>}
          {item.kind===3&&<div class="bwx-date"><span class="bwx-date-tile"><small>ต.ค.</small><b>27</b></span><span class="bwx-date-copy"><small>อังคาร</small><b>16:00–17:00</b></span></div>}
          {item.kind===4&&<div class="bwx-stepper"><i>–</i><span><b>2</b><small>ที่นั่ง</small></span><i class="is-on"><Icon name="plus"/></i></div>}
          {item.kind===5&&<div class="bwx-route"><span class="bwx-stop is-on"><b>09:00</b><i></i><small>เมืองเก่า</small></span><span class="bwx-route-line"><span></span></span><span class="bwx-stop"><b>11:30</b><i></i><small>ริมแม่น้ำ</small></span></div>}
          {item.kind===6&&<div class="bwx-hours"><div class="bwx-hours-axis"><span>09</span><span>10</span><span>11</span><span>12</span><span>13</span></div><div class="bwx-hours-track"><span class="bwx-hours-block">10:00–12:00</span></div></div>}
          {item.kind===7&&<div class="bwx-days"><span><small>พฤ.</small><b>22</b></span><span><small>ศ.</small><b>23</b></span><span class="is-on"><small>ส.</small><b>24</b></span><span><small>อา.</small><b>25</b></span></div>}
          <span class="bwx-hl-cap">{item.cap}</span>
        </div>
      </div>
      <h3>{businessLinks[item.kind] ? <a class="bw-business-detail-link" href={`${businessPrefix}/businesses/${businessLinks[item.kind]}/`}>{item.title}</a> : item.title}</h3><p>{item.description}</p>
    </article>)}
  </div></div>
  <p class="bw-directory-note">มีรูปแบบการจองในใจแล้ว? <a href="#contact">คุยกับทีมงาน <Icon name="arrow-up-right" class="bw-action-icon" /></a></p>
</section>
</div>
<style>
.bw-business-directory{display:flex;width:max-content;gap:24px}
.bw-industry-graphic{width:360px;flex:0 0 360px;min-width:0}
:global(#bookingwhale) #business .bw-industry-graphic h3{margin:20px 0 6px}
:global(#bookingwhale) #business .bw-industry-graphic>p{margin:0}
:global(#bookingwhale) .bw-directory-note{margin:30px 0 0}.bw-directory-note a{margin-left:8px}
:global(#bookingwhale) #business .bw-industry-viewport{overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding-bottom:12px;container-type:inline-size}
:global(#bookingwhale) #business .bw-business-directory{gap:24px}
:global(#bookingwhale) #business .bw-industry-graphic{width:calc((100cqw - 48px)/2.8);flex:0 0 calc((100cqw - 48px)/2.8)}
@media(min-width:1200px){:global(#bookingwhale) #business .bw-industry-graphic{width:calc((100cqw - 72px)/3.8);flex-basis:calc((100cqw - 72px)/3.8)}}
@media(max-width:767px){
:global(#bookingwhale) #business .bw-business-directory{gap:20px}
:global(#bookingwhale) #business .bw-industry-graphic{width:calc((100cqw - 20px)/1.15);flex-basis:calc((100cqw - 20px)/1.15)}
}
:global(#bookingwhale) #business .bw-industry-viewport::-webkit-scrollbar{display:none;width:0;height:0}
:global(#bookingwhale .is-business-track) #business .bw-industry-viewport{overflow:hidden;scroll-snap-type:none;padding-bottom:0}
@media(max-width:750px){.bw-directory-note a{display:block;margin-left:0}}

.bwx-snap{position:relative;display:flex;align-items:center;justify-content:center;height:300px;padding:0 20px;border-radius:28px;background:var(--bwx-grey,#f5f5f7);overflow:hidden;color:var(--bwx-ink,#1d1d1f);font-family:var(--bwx-font)}
.bwx-hl{display:flex;flex-direction:column;align-items:center;gap:18px;max-width:100%}
.bwx-hl-cap{font-size:13px;line-height:1.4;color:var(--bwx-muted,#6e6e73);white-space:nowrap}
.bwx-hl-label{font-size:16px;line-height:1.4;font-weight:600;letter-spacing:-.01em;color:var(--bwx-ink,#1d1d1f);text-align:center;text-wrap:balance}
.bwx-chips{display:flex;gap:8px}
.bwx-chips>span{display:grid;place-items:center;min-width:72px;height:46px;padding:0 10px;border-radius:14px;background:#fff;font-size:16px;color:var(--bwx-muted,#6e6e73);font-variant-numeric:tabular-nums;white-space:nowrap}
.bwx-chips>.is-on{background:var(--bwx-ink,#1d1d1f);color:#fff;font-weight:600}
.bwx-chips-wide>span{min-width:0;font-size:14px}
.bwx-seats{display:grid;grid-template-columns:repeat(4,30px);gap:10px}
.bwx-seats i{width:30px;height:30px;border-radius:50%;background:#fff;border:1px solid var(--bwx-hairline,#e5e5ea);box-sizing:border-box}
.bwx-seats i.is-on{background:var(--bwx-ink,#1d1d1f);border-color:var(--bwx-ink,#1d1d1f)}
.bwx-date{display:flex;align-items:center;gap:16px}
.bwx-date-tile{display:flex;flex-direction:column;align-items:center;justify-content:center;width:68px;height:72px;border-radius:16px;background:#fff}
.bwx-date-tile small,.bwx-date-copy small{font-size:12px;color:var(--bwx-muted,#6e6e73)}
.bwx-date-tile b{font-size:28px;line-height:1.1;font-weight:600}
.bwx-date-copy{display:flex;flex-direction:column;gap:2px}
.bwx-date-copy b{font-size:22px;font-weight:600;letter-spacing:-.02em;font-variant-numeric:tabular-nums;white-space:nowrap}
.bwx-stepper{display:flex;align-items:center;gap:22px}
.bwx-stepper>i{display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:#fff;font-style:normal;font-size:20px;color:var(--bwx-muted,#6e6e73)}
.bwx-stepper>i.is-on{background:var(--bwx-ink,#1d1d1f);color:#fff}
.bwx-stepper>i :global(svg){width:18px;height:18px}
.bwx-stepper>span{display:flex;flex-direction:column;align-items:center}
.bwx-stepper b{font-size:34px;line-height:1.1;font-weight:600;font-variant-numeric:tabular-nums}
.bwx-stepper small{font-size:12px;color:var(--bwx-muted,#6e6e73)}
.bwx-route{display:flex;align-items:flex-start}
.bwx-stop{display:flex;flex-direction:column;align-items:center;gap:8px}
.bwx-stop b{font-size:22px;font-weight:600;font-variant-numeric:tabular-nums}
.bwx-stop i{width:14px;height:14px;border-radius:50%;background:#fff;border:2px solid var(--bwx-ink,#1d1d1f);box-sizing:border-box}
.bwx-stop.is-on i{background:var(--bwx-ink,#1d1d1f)}
.bwx-stop small{font-size:13px;color:var(--bwx-muted,#6e6e73);white-space:nowrap}
.bwx-route-line{position:relative;width:clamp(48px,22cqw,96px);height:2px;margin:46px 8px 0;background:var(--bwx-line,#d2d2d7)}
.bwx-route-line>span{position:absolute;inset:0;background:var(--bwx-ink,#1d1d1f);transform-origin:left center}
.bwx-hours{width:min(240px,100%)}
.bwx-hours-axis{display:flex;justify-content:space-between;font-size:12px;color:var(--bwx-muted,#6e6e73);font-variant-numeric:tabular-nums}
.bwx-hours-track{position:relative;height:44px;margin-top:8px;border-radius:12px;background:#fff}
.bwx-hours-block{position:absolute;top:4px;bottom:4px;left:25%;right:25%;display:flex;align-items:center;justify-content:center;border-radius:9px;background:var(--bwx-ink,#1d1d1f);color:#fff;font-size:13px;font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap;transform-origin:left center}
.bwx-days{display:flex;gap:8px}
.bwx-days>span{display:flex;flex-direction:column;align-items:center;justify-content:center;width:52px;height:64px;border-radius:14px;background:#fff;color:var(--bwx-muted,#6e6e73)}
.bwx-days small{font-size:12px}
.bwx-days b{font-size:20px;font-weight:600;color:var(--bwx-ink,#1d1d1f)}
.bwx-days>.is-on{background:var(--bwx-ink,#1d1d1f);color:#c7c7cc}
.bwx-days>.is-on b{color:#fff}
@media(max-width:380px){.bwx-chips>span{min-width:60px}.bwx-days>span{width:46px}}
@media(max-width:767px){.bwx-snap{height:250px}}
</style>

<style>
  .bw-business-detail-link{color:inherit;text-decoration:none}
  .bw-business-detail-link:hover{text-decoration:underline;text-underline-offset:5px}
  .bw-business-detail-link:focus-visible{outline:2px solid #0747ff;outline-offset:4px}
</style>
