---
import { seasons } from '../data/seasons';
import '../styles/seasons/base.css';
import '../styles/seasons/christmas.css';
const ranges = seasons.map(({ id, start, end }) => ({ id, start, end }));
---
<script is:inline define:vars={{ ranges }}>(function(){var requested=new URLSearchParams(location.search).get('theme');var now=new Date();var today=String(now.getMonth()+1).padStart(2,'0')+'-'+String(now.getDate()).padStart(2,'0');var active=ranges.find(function(r){if(requested)return r.id===requested;return r.start<=r.end?today>=r.start&&today<=r.end:today>=r.start||today<=r.end;});if(active)document.documentElement.dataset.season=active.id;})();</script>
<script>import { initSeason } from "../scripts/seasons"; initSeason();</script>
