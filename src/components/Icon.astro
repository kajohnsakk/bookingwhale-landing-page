---
import icons from './icons.json';
interface Props { name: keyof typeof icons; class?: string; }
const { name, class: className } = Astro.props;
---
<svg class:list={["bw-icon", className]} data-lucide={name} xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={icons[name]} />
