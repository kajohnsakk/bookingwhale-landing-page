---
import { Image } from "astro:assets";
import { t } from "../i18n/utils";
import type { Lang } from "../i18n/utils";
import dashboardShot from "../assets/images/cta/dashboard.webp";
import bookingPhoneShot from "../assets/images/cta/booking-phone4.webp";

interface Props {
  lang?: Lang;
}
const { lang = "th" } = Astro.props;
---

<section class="bg-white">
  <div
    class="mx-auto px-6 sm:px-10 md:px-14 lg:px-24 max-w-[1400px] pb-16 lg:pb-24"
  >
    <div data-animate="scroll-reveal">
      <div
        class="relative overflow-hidden bg-blue-600 rounded-[2rem] lg:rounded-[3rem] px-6 sm:px-12 lg:px-16 py-14 lg:py-20"
      >
        <div
          class="pointer-events-none absolute -top-28 -left-28 w-96 h-96 rounded-full bg-white/10 blur-3xl"
        >
        </div>
        <div
          class="pointer-events-none absolute -bottom-36 -right-24 w-[28rem] h-[28rem] rounded-full bg-blue-400/40 blur-3xl"
        >
        </div>
        <div
          class="pointer-events-none absolute inset-0 rounded-[2rem] lg:rounded-[3rem] ring-1 ring-inset ring-white/10"
        >
        </div>

        <div
          class="relative grid lg:grid-cols-[1fr_1.1fr] gap-12 lg:gap-16 items-center"
        >
          <div class="text-center lg:text-left">
            <p
              class="text-[11px] sm:text-xs font-black uppercase tracking-[0.3em] text-blue-200"
            >
              Booking Whale
            </p>
            <h2
              data-translate="ctaTitle"
              class="mt-4 text-[1.9rem] sm:text-[2.5rem] lg:text-[2.75rem] font-black text-white tracking-[-0.02em] leading-[1.15]"
            >
              {t("ctaTitle", lang)}
            </h2>
            <p
              data-translate="ctaSubtitle"
              class="text-base sm:text-lg lg:text-xl text-blue-100 mt-5 leading-relaxed font-medium max-w-xl mx-auto lg:mx-0"
            >
              {t("ctaSubtitle", lang)}
            </p>

            <div
              class="mt-10 flex flex-col sm:flex-row gap-4 justify-center lg:justify-start items-center"
            >
              <a
                href={lang === "en" ? "/en/contact" : "/contact"}
                data-translate="startBookingNow"
                class="w-full sm:w-auto sm:min-w-[200px] text-center bg-white text-blue-600 hover:bg-blue-50 px-9 py-4 rounded-full font-bold text-base lg:text-lg transition-colors duration-200 shadow-lg shadow-blue-900/20"
              >
                {t("startBookingNow", lang)}
              </a>
              <a
                href="#features"
                data-translate="learnMore"
                class="w-full sm:w-auto sm:min-w-[200px] text-center text-white px-9 py-4 rounded-full font-bold text-base lg:text-lg border-2 border-white/40 hover:border-white/70 hover:bg-white/10 transition-all duration-200"
              >
                {t("learnMore", lang)}
              </a>
            </div>
          </div>

          <div class="relative hidden sm:block pl-10 lg:pl-14 pb-10">
            <div
              class="relative ml-auto max-w-[560px] rotate-[-1.5deg] rounded-2xl bg-white shadow-2xl shadow-blue-950/40 overflow-hidden"
            >
              <div
                class="flex items-center gap-3 h-9 px-4 bg-slate-50 border-b border-slate-200"
              >
                <span class="flex items-center gap-1.5">
                  <span class="w-2.5 h-2.5 rounded-full bg-red-300"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-amber-300"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-emerald-300"></span>
                </span>
                <span
                  class="flex-1 max-w-[240px] mx-auto flex items-center justify-center gap-1.5 h-5.5 py-1 px-3 bg-white border border-slate-200 rounded-md text-[10px] font-medium text-slate-400"
                >
                  <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                  bookingwhale.co
                </span>
                <span class="w-[52px]"></span>
              </div>
              <Image
                src={dashboardShot}
                alt="แดชบอร์ดหลังร้าน Booking Whale แสดงจำนวนการจองวันนี้ กราฟช่วงเวลา และรายการจองล่าสุด"
                width={560}
                height={308}
                densities={[1, 2]}
                quality={92}
                class="w-full h-auto"
                loading="lazy"
                decoding="async"
              />
            </div>

            <div
              class="absolute -bottom-2 left-0 w-36 lg:w-40 rotate-[2.5deg] rounded-[1.6rem] overflow-hidden bg-white shadow-2xl shadow-blue-950/50 ring-4 ring-white"
            >
              <Image
                src={bookingPhoneShot}
                alt="หน้าจองผ่าน LINE ของลูกค้า แสดงปฏิทินเลือกวันจอง"
                width={160}
                height={287}
                densities={[1, 2]}
                quality={92}
                class="w-full h-auto"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
