---
interface Props { kind: number; }
const {kind}=Astro.props;
---
<svg class="bw-business-symbol-art" viewBox="0 0 64 64" fill="currentColor" aria-hidden="true" focusable="false">
  {kind===0&&<>
    <g class="bw-symbol-utensils" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
      <path class="bw-symbol-fork" d="M15 12v14a7 7 0 0 0 14 0V12M22 12v40" />
      <g class="bw-symbol-spoon"><ellipse cx="44" cy="23" rx="7" ry="12" /><path d="M44 35v17" /></g>
    </g>
  </>}
  {kind===1&&<><ellipse cx="32" cy="24" rx="8" ry="16"/><g class="bw-symbol-petal-left"><ellipse cx="23" cy="31" rx="8" ry="15" transform="rotate(-45 23 31)"/></g><g class="bw-symbol-petal-right"><ellipse cx="41" cy="31" rx="8" ry="15" transform="rotate(45 41 31)"/></g><path d="M13 44c11-4 17 0 19 8 2-8 8-12 19-8-3 10-13 13-19 10-6 3-16 0-19-10Z"/></>}
  {kind===2&&<g class="bw-symbol-weight"><g transform="rotate(-25 32 32)"><rect x="8" y="23" width="7" height="18" rx="2"/><rect x="15" y="17" width="9" height="30" rx="3"/><rect x="23" y="28" width="18" height="8"/><rect x="40" y="17" width="9" height="30" rx="3"/><rect x="49" y="23" width="7" height="18" rx="2"/></g></g>}
  {kind===3&&<><g class="bw-symbol-cap"><path d="m5 23 27-13 27 13-27 13ZM16 32l16 8 16-8v14c-10 8-22 8-32 0Z"/><path d="M53 26h4v19h-4z"/><circle cx="55" cy="48" r="4"/></g></>}
  {kind===4&&<g class="bw-symbol-ticket"><path d="M9 15h46v12a6 6 0 0 0 0 12v10H9V39a6 6 0 0 0 0-12Zm29 4v6h3v-6Zm0 10v6h3v-6Zm0 10v6h3v-6Z" fill-rule="evenodd"/><path d="M17 25h14v4H17zm0 9h10v4H17z" fill="#fff"/></g>}
  {kind===5&&<><path d="m7 16 15-5v39L7 55zm19-5 13 5v39l-13-5zm17 5 14-5v39l-14 5Z" opacity=".45"/><path class="bw-symbol-route" d="M13 43c12 0 3-18 15-18s5 18 20 5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" pathLength="1"/><g class="bw-symbol-pin"><path d="M47 9a9 9 0 0 0-9 9c0 7 9 15 9 15s9-8 9-15a9 9 0 0 0-9-9Zm0 5a4 4 0 1 1 0 8 4 4 0 0 1 0-8Z" fill-rule="evenodd"/></g></>}
  {kind===6&&<g class="bw-symbol-key"><path d="M26 8a16 16 0 1 0 12 27l6 6v7h7v7h7V43L42 27A16 16 0 0 0 26 8Zm-4 7a6 6 0 1 1 0 12 6 6 0 0 1 0-12Z" fill-rule="evenodd"/></g>}
  {kind===7&&<g class="bw-symbol-gear"><path d="m27 7-2 7-5 3-7-2-5 9 5 5v6l-5 5 5 9 7-2 5 3 2 7h10l2-7 5-3 7 2 5-9-5-5v-6l5-5-5-9-7 2-5-3-2-7Zm5 15a10 10 0 1 1 0 20 10 10 0 0 1 0-20Z" fill-rule="evenodd"/></g>}
</svg>
