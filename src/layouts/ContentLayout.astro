---
import '../styles/fonts.css';
import thaiBodyFont from '../assets/fonts/noto-sans-thai-thai-range.woff2?url';
import thaiHeadingFont from '../assets/fonts/anuphan-thai-range.woff2?url';
import latinBodyFont from '../assets/fonts/noto-sans-thai-latin-range.woff2?url';
import latinHeadingFont from '../assets/fonts/anuphan-latin-core.woff2?url';
import '../styles/editorial.css';
import { localePath, translate, type Locale } from '../i18n';
import { buildSeo } from '../seo/metadata';
import { canonicalPath, languageAlternates } from '../seo/routes.mjs';
import CookieConsent from '../components/CookieConsent.astro';
import ContactDialog from '../components/ContactDialog.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
interface Props {
  title: string;
  description: string;
  locale?: Locale;
  breadcrumb?: { name: string; path: string }[];
  article?: { title: string; published: Date; modified?: Date; image?: string };
  noindex?: boolean;
}
const { title: rawTitle, description: rawDescription, locale = 'th', breadcrumb = [], article, noindex = false } = Astro.props;
const title = translate(rawTitle, locale);
const description = translate(rawDescription, locale);
if (!Astro.site) throw new Error('A public site URL is required.');
const seo = buildSeo(Astro.site, locale, { title, description });
const canonical = new URL(canonicalPath(Astro.url.pathname), Astro.site).href;
const alternates = languageAlternates(Astro.url.pathname);
const image = article?.image ? new URL(article.image, Astro.site).href : seo.image;
const home = localePath(locale);
const isThai = locale !== 'en';
const crumbs = [{ name: isThai ? 'หน้าแรก' : 'Home', path: home }, ...breadcrumb].map(crumb => ({ ...crumb, name: translate(crumb.name, locale) }));
const schema = JSON.parse(seo.schema);
const webpage = schema['@graph'].find((node: Record<string, unknown>) => node['@type'] === 'WebPage');
webpage['@id'] = `${canonical}#webpage`;
webpage.url = canonical;
webpage.primaryImageOfPage = { '@type': 'ImageObject', url: image, caption: article?.title || seo.imageAlt };
if (crumbs.length > 1) {
  webpage.breadcrumb = { '@id': `${canonical}#breadcrumb` };
  schema['@graph'].push({ '@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumb`, itemListElement: crumbs.map((item, i) => ({ '@type': 'ListItem', position: i + 1, name: item.name, item: new URL(item.path, Astro.site).href })) });
}
if (article) schema['@graph'].push({
  '@type': 'BlogPosting', '@id': `${canonical}#article`, headline: article.title, description,
  url: canonical, inLanguage: seo.language, mainEntityOfPage: { '@id': webpage['@id'] },
  datePublished: article.published.toISOString(), ...(article.modified ? { dateModified: article.modified.toISOString() } : {}),
  image, publisher: { '@id': `${seo.home}#organization` },
});
---
<!doctype html>
<html lang={seo.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {locale==='th'&&<><link rel="preload" as="font" type="font/woff2" href={thaiBodyFont} crossorigin="anonymous" /><link rel="preload" as="font" type="font/woff2" href={thaiHeadingFont} crossorigin="anonymous" /></>}
    {locale!=='zh'&&<><link rel="preload" as="font" type="font/woff2" href={latinBodyFont} crossorigin="anonymous" /><link rel="preload" as="font" type="font/woff2" href={latinHeadingFont} crossorigin="anonymous" /></>}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    {alternates.map(item => <link rel="alternate" hreflang={item.language} href={new URL(item.path, Astro.site).href} />)}
    <link rel="alternate" type="application/rss+xml" title="Booking Whale Blog" href="/rss.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon-bookingwhale.svg" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content={seo.ogLocale} />
    <meta property="og:site_name" content="Booking Whale" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={article?.title || seo.imageAlt} />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article?.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={article?.title || seo.imageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\u003c')} />
  </head>
  <body class="bw-editorial-page" id="top">
    <a class="editorial-skip" href="#main-content">{isThai ? 'ข้ามไปเนื้อหา' : 'Skip to content'}</a>
    <div id="bookingwhale">
      <Navbar sectionBase={home} contentPage />
      <main id="main-content" class="editorial-container">
        {crumbs.length > 1 && <nav class="editorial-breadcrumb" aria-label={isThai ? 'เส้นทางหน้าเว็บ' : 'Breadcrumb'}><ol>{crumbs.map((crumb, i) => <li>{i === crumbs.length - 1 ? <span aria-current="page">{crumb.name}</span> : <a href={crumb.path}>{crumb.name}</a>}</li>)}</ol></nav>}
        <slot />
      </main>
      <Footer sectionBase={home} />
      <ContactDialog />
    </div>
    <script>import '../scripts/editorial-navigation.js';</script>
    <CookieConsent />
  </body>
</html>
